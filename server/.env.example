# Copy to .env (never commit .env).

# MongoDB Atlas connection string. Leave unset to use a temporary in-memory database
# that is seeded with demo data on every start (handy for local development and E2E tests).
MONGODB_URI=

# Secret used to sign login tokens. REQUIRED in production (use a long random string, e.g.
# `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`).
# Locally a fixed development value is used if this is unset.
JWT_SECRET=

PORT=3000

# New listings open to everyone after this many minutes.
CHARITY_PRIORITY_MINUTES=15
# Product estimate, not a nutritional measurement. Snapshotted per reservation.
GRAMS_PER_MEAL=500
